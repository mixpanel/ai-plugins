#!/usr/bin/env bash
set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[0;33m'
BOLD='\033[1m'
RESET='\033[0m'

legacy_changed=$(git diff --cached --name-only -- \
    plugins/mixpanel-mcp/ plugins/mixpanel-mcp-eu/ plugins/mixpanel-mcp-in/ | head -1)

if [ -n "$legacy_changed" ]; then
    echo ""
    echo -e "${RED}${BOLD}ERROR:${RESET} Legacy plugins are frozen at ${BOLD}v0.1.1${RESET}."
    echo ""
    echo -e "  \`mixpanel-mcp\`, \`mixpanel-mcp-eu\`, and \`mixpanel-mcp-in\` are deprecated and"
    echo -e "  must stay byte-identical to the v0.1.1 tag so existing installs never change."
    echo -e "  Edit ${BOLD}plugins/mixpanel/${RESET} instead."
    echo -e "  To skip this check: ${YELLOW}git commit -n -m 'commit message'${RESET}"
    echo ""
    exit 1
fi
